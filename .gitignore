# This .gitignore file is placed at the root of the Unity project directory
# Ignores Unity temporary/cache files, build outputs, IDE files, and OS artifacts.

# Unity temporary / cache / generated directories
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# JetBrains Rider plugin
[Aa]ssets/Plugins/Editor/JetBrains*

# IDE / Editor configuration & cache directories
.vs/
.idea/
.vscode/
.gradle/
ExportedObj/
.consulo/

# Autogenerated Visual Studio / MonoDevelop solution & project files
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity crash reports & telemetry
sysinfo.txt
crashlytics-build.properties

# Builds
*.apk
*.aab
*.unitypackage
*.app

# OS generated files (macOS & Windows)
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
[Tt]humbs.db
